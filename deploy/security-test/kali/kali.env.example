#!/usr/bin/env bash

# Copy this file to $HOME/sja-kali.env, edit it, and run:
#   chmod 600 $HOME/sja-kali.env
#   source $HOME/sja-kali.env
#
# Do not put passwords, JWTs, cookies, or production data in this file.

export TARGET_IP='192.168.255.128'
export BASE_URL="http://${TARGET_IP}"
export TEST_ID="sja-$(date +%Y%m%d-%H%M%S)"
export EVIDENCE="$HOME/security-tests/$TEST_ID"

# Only these ports are in scope for the safe baseline.
export SJA_SELECTED_PORTS='22,80,443,8080,3306,33060,6379'

