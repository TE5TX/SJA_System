# 复制为 .env 后再修改。不要把真实密钥提交到 Git。
SJA_HOST=192.168.255.128
WEB_PORT=80
# WEB_PORT 不是 80 时，例如 8088，请设置为 :8088；使用 80 时留空。
WEB_ORIGIN_PORT=

MYSQL_ROOT_PASSWORD=请替换为高强度数据库root密码
MYSQL_PASSWORD=请替换为高强度数据库应用密码
REDIS_PASSWORD=请替换为高强度Redis密码
# 至少 32 个随机字符；可用 openssl rand -base64 48 生成。
SJA_JWT_SECRET=请替换为至少32个随机字符的JWT密钥
# 202608192148 - Redis 异步任务正文的独立加密密钥，可用 openssl rand -base64 48 生成。
SJA_ASYNC_TASK_ENCRYPTION_KEY=请替换为至少32个随机字符的异步任务加密密钥
# 202609201556 - 单实例可留空自动生成；多实例显式填写时每个实例必须不同。
SJA_ASYNC_TASK_CONSUMER_NAME=
SJA_ASYNC_TASK_CONSUMER_LEASE_TTL=90s
SJA_ASYNC_TASK_CONSUMER_LEASE_RENEW_INTERVAL=30s
# 2核2GB建议4；如数据库压力仍高可降为2，不建议在该配置上超过4。
SJA_ASYNC_TASK_WORKER_COUNT=4

# 202608192148 - 2核2GB单机的保守资源配置；4GB内存可按维护文档提高。
MYSQL_MEMORY_LIMIT=640m
MYSQL_INNODB_BUFFER_POOL_SIZE=192M
MYSQL_MAX_CONNECTIONS=40
REDIS_MEMORY_LIMIT=128m
REDIS_MAXMEMORY=96mb
BACKEND_MEMORY_LIMIT=640m
WEB_MEMORY_LIMIT=64m
CLOUDFLARED_MEMORY_LIMIT=128m
SJA_DB_POOL_MAX_SIZE=10
SJA_TOMCAT_MAX_THREADS=80

# 202609201535 - 该开关统一控制Access、Refresh及CSRF Cookie的Secure属性；HTTPS生产环境必须为true。
# 当前通过局域网 IP + HTTP 访问时只能设为 false；启用 HTTPS 后必须改为 true。
SJA_REFRESH_COOKIE_SECURE=false

# 使用 deploy/docker-compose.public.yml 接入公网时填写，普通局域网部署可留空。
# SJA_PUBLIC_ORIGIN 必须只有协议和域名，不要带末尾斜杠或路径。
SJA_PUBLIC_ORIGIN=
CLOUDFLARE_TUNNEL_TOKEN=

# 202608210907 - 批量注册预览令牌默认10分钟有效，单次最多500人且xlsx不超过2MB。
SJA_USER_IMPORT_TOKEN_TTL_SECONDS=600
SJA_USER_IMPORT_MAX_FILE_BYTES=2097152
SJA_USER_IMPORT_MAX_ROWS=500
