# 复制为 .env 后再修改。不要把真实密钥提交到 Git。
SJA_HOST=192.168.255.128
WEB_PORT=80
# WEB_PORT 不是 80 时，例如 8088，请设置为 :8088；使用 80 时留空。
WEB_ORIGIN_PORT=

MYSQL_ROOT_PASSWORD=请替换为高强度数据库root密码
MYSQL_PASSWORD=请替换为高强度数据库应用密码
REDIS_PASSWORD=请替换为高强度Redis密码
# 至少 32 个随机字符；可用 openssl rand -base64 48 生成。
SJA_JWT_SECRET=请替换为至少32个随机字符的JWT密钥

# 当前通过局域网 IP + HTTP 访问，必须为 false；以后启用 HTTPS 后改为 true。
SJA_REFRESH_COOKIE_SECURE=false
